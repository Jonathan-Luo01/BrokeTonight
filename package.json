{
  "name": "broketonight",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npx tsx index.ts",
    "dev:all": "concurrently -n \"server,client\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "worker:dev": "cd worker && wrangler dev",
    "worker:deploy": "cd worker && wrangler deploy",
    "build": "cd client && GITHUB_PAGES=true npm run build && mkdir -p ../docs && cp -r dist/* ../docs/ && cp -r dist/assets ../ && cp dist/index.html dist/404.html dist/manifest.json dist/favicon.png dist/apple-touch-icon.png dist/sw.js ../ && touch ../.nojekyll ../docs/.nojekyll",
    "start": "npm run dev:all",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "concurrently": "^9.0.0"
  }
}
